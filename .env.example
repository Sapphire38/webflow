# Copiar a .env.local para desarrollo. En Webflow Cloud se cargan en Environment variables.
# Nunca commitear valores reales.

# Supabase (Project Settings > API). La anon key es pública; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# MiniMax (endpoint compatible con OpenAI). Marcar como Secret en Webflow Cloud.
MINIMAX_API_KEY=<api-key>
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7

# Clave para cifrar headers de APIs y tokens de Drive (mínimo 16 caracteres). Secret.
# Generar con: openssl rand -base64 32
FUENTES_SECRET=<clave-larga-aleatoria>

# Google Drive (opcional). Cliente OAuth "Web application" en Google Cloud Console.
# Redirect URI autorizada: https://<tu-app>/api/drive/callback (y http://localhost:3000/api/drive/callback)
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# Reportes programados. CRON_SECRET protege /api/cron/reportes (lo llama pg_cron, ver supabase/cron.sql).
# El cron necesita la service role en el deploy (Secret): corre sin sesión de usuario.
CRON_SECRET=<clave-larga-aleatoria>
# Email: Selene Hub (POST /sendEmail con x-api-key) o, si está, Resend (tiene prioridad). Sin ninguno, solo Slack.
SELENE_HUB_URL=https://<hub>/server/api
SELENE_HUB_API_KEY=<sk_...>
RESEND_API_KEY=
EMAIL_FROM=Insight <reportes@tu-dominio.com>

# Mount path de Webflow Cloud (vacío si la app está en la raíz). Solo para fetch/img manuales.
NEXT_PUBLIC_BASE_PATH=

# Service role: la usan `npm run seed:demo` (local) y el cron de reportes (deploy, como Secret).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Solo para el seed de la cuenta del jurado.
DEMO_EMAIL=<email-de-la-cuenta-demo>
DEMO_PASSWORD=<password-de-la-cuenta-demo>
